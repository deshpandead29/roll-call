# Supabase project settings > API. For local development, `npx supabase start`
# prints both.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Web Push. Generate a pair with `npx web-push generate-vapid-keys`.
# The private key is a secret: set it in Vercel, never in the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional. Defaults to the site's https URL.
VAPID_SUBJECT=

# Optional. Lets the daily cron announce reveals ("Lisbon is out"). Use the
# same value in private.secrets (see supabase/migrations/20261030000000_reveal_push.sql).
CRON_SECRET=
